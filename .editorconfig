root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning
# Every member on the boundary of a type guards the reference arguments it declared non-null. The
# annotation states that contract with the compiler; nothing enforces it for a caller with nullable
# disabled, or for a value arriving through reflection, DI or a deserializer.
#
# `internal` is included because the boundary is the type, not the assembly.
dotnet_diagnostic.CA1062.severity = warning
dotnet_code_quality.CA1062.api_surface = public, internal

# IDE0028 asks for `[]`, which trips CA1825 on the 10.0.100 analyzers — the SDK floor declared in
# global.json and one of the two CI legs, where a warning is an error. Nine sites, every one of them
# a xUnit TheoryData, so this is one class of code rather than a handful of exceptions.
#
# Remove this the day the floor in global.json moves past the analyzers that disagree.
[tests/**.cs]
dotnet_diagnostic.IDE0028.severity = none
