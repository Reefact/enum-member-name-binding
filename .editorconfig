root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning

# An `if` whose whole body is one exit is written on one line — `if (name is null) { return; }`.
# The braces are still required by the rule above; what this setting protects is the line they sit
# on. Set to false, the formatter breaks every one of them apart, so it is pinned rather than left
# to the default: `tools/style/lint-layout.sh` would then report what Format Document
# had just done.
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# Every member on the boundary of a type guards the reference arguments it declared non-null. The
# annotation states that contract with the compiler; nothing enforces it for a caller with nullable
# disabled, or for a value arriving through reflection, DI or a deserializer.
#
# `internal` is included because the boundary is the type, not the assembly.
dotnet_diagnostic.CA1062.severity = warning
dotnet_code_quality.CA1062.api_surface = public, internal

# IDE0130 does nothing without this option, whatever its severity says — so leaving the option out
# was not "the rule does not apply here", it was the rule never running. Written down, the build now
# agrees with the editor, which has always shown it: two registration entry points are deliberately
# in Microsoft.Extensions.DependencyInjection and carry a pragma saying so.
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning

# IDE0005 needs GenerateDocumentationFile, which all three src projects set and no test project
# does — enabling it solution-wide makes the compiler refuse to build rather than report anything.
# Scoped here it costs nothing and catches a using that outlived what needed it, including two the
# implicit usings had already made redundant.
[src/**.cs]
dotnet_diagnostic.IDE0005.severity = warning

# IDE0028 asks for `[]`, which trips CA1825 on the 10.0.100 analyzers — the SDK floor declared in
# global.json and one of the two CI legs, where a warning is an error. Nine sites, every one of them
# a xUnit TheoryData, so this is one class of code rather than a handful of exceptions.
#
# Remove this the day the floor in global.json moves past the analyzers that disagree.
[tests/**.cs]
dotnet_diagnostic.IDE0028.severity = none
