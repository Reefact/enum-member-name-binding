<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables: the runner is the assembly's own entry point. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>AspNetCore.EnumMemberNameBinding.Analyzers.Tests</RootNamespace>
    <AssemblyName>AspNetCore.EnumMemberNameBinding.Analyzers.Tests</AssemblyName>
    <NoWarn>$(NoWarn);CA1707;CA1034;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AspNetCore.EnumMemberNameBinding.Analyzers/AspNetCore.EnumMemberNameBinding.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule identifiers used by this project's SuppressMessage attributes, as constants the
         compiler resolves. PrivateAssets because nothing of it survives compilation: the constants
         fold to literals and the analyzers are a build-time check. -->
    <PackageReference Include="DiagnosticCatalog.CodeStyle" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Emits the coverage report the Sonar analysis reads. The format lives in
         coverage.runsettings, so a local run and the analysis produce the same report. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
