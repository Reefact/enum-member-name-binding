<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables: the runner is the assembly's own entry point. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>AspNetCore.EnumMemberNameBinding.Tests</RootNamespace>
    <AssemblyName>AspNetCore.EnumMemberNameBinding.Tests</AssemblyName>
    <!--
      CA1707/CA1034/CA2007: test-naming and fixture conventions.
      CA1069: the duplicate-value enum is a deliberate fixture.
      CA1711: xUnit collection fixtures are named '...Collection' by convention.
    -->
    <!-- CA1001: xUnit disposes fixtures through IAsyncLifetime, not IDisposable. -->
    <NoWarn>$(NoWarn);CA1707;CA1034;CA2007;CA1069;CA1711;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/AspNetCore.EnumMemberNameBinding/AspNetCore.EnumMemberNameBinding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
