<?xml version="1.0" encoding="utf-8"?>
<!--
  <clear /> matters: without it the machine's own sources are appended, and the package under test
  could be served by one of them instead of the feed this run just built.

  nuget.org stays, because the fixtures' other dependencies have to come from somewhere. It cannot
  serve the package under test: run.sh packs it as 0.0.0-smoke, a version that is never published,
  so the local feed is the only place it exists. run.sh asserts that afterwards rather than trusting
  it — see the "resolved from the local feed" check.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="package-smoke-feed" value=".work/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
