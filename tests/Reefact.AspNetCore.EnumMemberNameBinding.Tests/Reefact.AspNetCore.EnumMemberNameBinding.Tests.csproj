<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables: the runner is the assembly's own entry point. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Reefact.AspNetCore.EnumMemberNameBinding.Tests</RootNamespace>
    <AssemblyName>Reefact.AspNetCore.EnumMemberNameBinding.Tests</AssemblyName>
    <!--
      CA1707/CA1034/CA2007: test-naming and fixture conventions.
      CA1069: the duplicate-value enum is a deliberate fixture.
      CA1711: xUnit collection fixtures are named '...Collection' by convention.
    -->
    <!-- CA1001: xUnit disposes fixtures through IAsyncLifetime, not IDisposable. -->
    <NoWarn>$(NoWarn);CA1707;CA1034;CA2007;CA1069;CA1711;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/Reefact.AspNetCore.EnumMemberNameBinding/Reefact.AspNetCore.EnumMemberNameBinding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule identifiers used by this project's SuppressMessage attributes, as constants the
         compiler resolves. PrivateAssets because nothing of it survives compilation: the constants
         fold to literals and the analyzers are a build-time check. -->
    <PackageReference Include="DiagnosticCatalog.NetAnalyzers" Version="1.0.0" PrivateAssets="all" />
    <!-- Assertions. xUnit still discovers, runs and reports; only the assertion is NFluent.
         See docs/for-maintainers/adr/0001-nfluent-for-test-assertions.en.md. -->
    <PackageReference Include="NFluent" Version="3.1.0" />
    <PackageReference Include="NFluent.Analyzer" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Emits the coverage report the Sonar analysis reads. The format lives in
         coverage.runsettings, so a local run and the analysis produce the same report. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
