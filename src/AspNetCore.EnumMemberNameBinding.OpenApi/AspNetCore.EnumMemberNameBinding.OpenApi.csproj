<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AspNetCore.EnumMemberNameBinding.OpenApi</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>AspNetCore.EnumMemberNameBinding.OpenApi</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Makes the OpenAPI document generated by ASP.NET Core describe the enum values the server actually accepts: contract names instead of C# names, an explicit string type, and a checkable pattern for [Flags] enums.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AspNetCore.EnumMemberNameBinding/AspNetCore.EnumMemberNameBinding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.x resolves Microsoft.OpenApi 2.0.0, which carries a known
      high-severity advisory (GHSA-v5pm-xwqc-g5wc). Raising the floor keeps consumers off it while
      staying inside the 2.x range the ASP.NET Core package is built against.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspNetCore.EnumMemberNameBinding.OpenApi.Tests" />
  </ItemGroup>

</Project>
