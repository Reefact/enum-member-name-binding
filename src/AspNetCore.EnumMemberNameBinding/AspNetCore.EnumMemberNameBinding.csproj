<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AspNetCore.EnumMemberNameBinding</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>AspNetCore.EnumMemberNameBinding</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The library is not trim- or AOT-safe, but the analyzers are on so that every entry point
         carrying that constraint is annotated, and consumers are warned accurately. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <Description>Makes ASP.NET Core route, query string, form and header model binding honor the enum member names declared with System.Text.Json's [JsonStringEnumMemberName]. One enum contract, applied consistently on every input channel — not just the request body.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The trimming and AOT rule identifiers used by this project's UnconditionalSuppressMessage
         attributes. PrivateAssets is load-bearing here: this project is packable, and without it a
         consumer of the published package would inherit a dependency on a compile-time catalogue. -->
    <PackageReference Include="DiagnosticCatalog.Trimming" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The analyzers ship inside this package: a contract mistake should be a build error in the editor,
    not an exception discovered when the application starts.
  -->
  <ItemGroup>
    <ProjectReference Include="../AspNetCore.EnumMemberNameBinding.Analyzers/AspNetCore.EnumMemberNameBinding.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="../AspNetCore.EnumMemberNameBinding.Analyzers/bin/$(Configuration)/netstandard2.0/AspNetCore.EnumMemberNameBinding.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspNetCore.EnumMemberNameBinding.Tests" />
  </ItemGroup>

</Project>
