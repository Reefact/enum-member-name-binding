<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Versioning: the Git tag is the source of truth. Local builds produce 0.0.0-dev;
    the release workflow passes -p:Version=<tag without leading v>.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>
    <Copyright>Copyright (c) Reefact</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- The file itself is included per project, beside the README, because this file is imported
         above the project body: a condition on IsPackable would be read before the csproj sets it. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Reefact/enum-member-name-binding</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/enum-member-name-binding</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>aspnetcore;enum;model-binding;system-text-json;openapi;api-contract</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Defaults">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
